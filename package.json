{
  "name": "@mfe-sols/mfe-landing-vchat",
  "version": "0.1.0",
  "description": "VChat landing page microfrontend module (React + single-spa)",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "postinstall": "node sync-ui-kit-css.js",
    "sync-css": "node sync-ui-kit-css.js",
    "start": "webpack serve --port 9015 --env standalone",
    "start:standalone": "webpack serve --env standalone",
    "build": "pnpm run build:webpack && pnpm run build:types",
    "build:webpack": "webpack --mode=production",
    "build:types": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "deps:lock": "NODE_AUTH_TOKEN=${NODE_AUTH_TOKEN:-$GITHUB_TOKEN} pnpm install --lockfile-only --no-frozen-lockfile",
    "deps:sync": "NODE_AUTH_TOKEN=${NODE_AUTH_TOKEN:-$GITHUB_TOKEN} pnpm install --no-frozen-lockfile",
    "deps:check-lock": "pnpm install --frozen-lockfile --ignore-scripts"
  },
  "types": "dist/org-mfe-landing-vchat.js.d.ts",
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@mfe-sols/i18n": "^0.1.1",
    "@mfe-sols/ui-kit": "^0.1.5",
    "@tanstack/query-core": "^5.62.0",
    "@tanstack/react-query": "^5.62.0",
    "gsap": "^3.14.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "single-spa": "^5.9.3",
    "single-spa-react": "^6.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^6.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "typescript": "^5.5.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^4.10.0",
    "webpack-config-single-spa-react-ts": "^8.0.0",
    "webpack-dev-server": "^4.0.0",
    "webpack-merge": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mfe-sols/mfe-orchestra.git"
  },
  "engines": {
    "node": "20.x"
  },
  "license": "MIT"
}
